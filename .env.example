# Butchr daemon config. Copy to .env and fill in. The token is a classic
# Atlassian API token (id.atlassian.com) used as Basic auth with the email.
ATLASSIAN_SITE=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
# Prefer a file so the token never sits in the environment / shell history:
ATLASSIAN_TOKEN_FILE=/path/to/atlassian-token
# ...or inline (less safe):
# ATLASSIAN_TOKEN=your-token
BUTCHR_PORT=7717
# HERDR_SOCKET=/home/you/.config/herdr/herdr.sock   # defaults to herdr's own

# pr:* labels (optional): both are required to enable PR discovery, since an
# unscoped GitHub search would span all of GitHub, not just your orgs. Either
# absent/empty skips pr:* discovery entirely (agent:* labels still work).
# GITHUB_TOKEN_FILE=/path/to/github-token
# BUTCHR_GITHUB_ORGS=your-org,another-org

# Minutes an active ticket's agent must sit idle/done, continuously since
# first observed running, with zero comments from this account, before it's
# surfaced as agent:stalled (a swallowed kickoff must never look finished).
# BUTCHR_STALLED_MINUTES=10

# Minutes a staffed child ticket must sit continuously in To Do under a live
# (In Progress) boss before the parked-ticket detector escalates it (also the
# interval between each of its three escalation stages — see
# src/agents/parked.ts). The poll loop runs every 15s, and a boss filing and
# activating a child normally does both within one agent turn — seconds to a
# couple of minutes — so 10 minutes is far outside any legitimate
# mid-decomposition window while still catching a genuinely parked ticket in
# minutes rather than a working day. Matches BUTCHR_STALLED_MINUTES's default,
# which measures a comparable "this agent has gone quiet" interval. A ticket
# that is deliberately left parked can be exempted by adding the
# `butchr:shelved` label to it (any actor may set it — a human today, or an
# automated shelving tool in future) — the daemon never adds or removes that
# label itself, only reads it.
# BUTCHR_PARKED_MINUTES=10

# Minutes a pane's herdr status must read idle/done, CONTINUOUSLY, before its
# text is read to check for an end-of-pane dialog herdr's own classification
# missed (herdr called all five panes idle/done for ~12 hours while frozen on
# the effort-recommendation dialog, 2026-08-30 — this is the backup net for
# the next dialog herdr misses too). Kept short deliberately: escalating a
# dialog we could have answered costs one notification; failing to escalate
# one we cannot answer costs hours times the number of agents sitting on it.
# BUTCHR_IDLE_DIALOG_MINUTES=2

# Milliseconds `/health` tolerates the poll loop going without a
# successfully-completed cycle before reporting it stale (also the startup
# grace period). Default 60000 — a 4x multiple of the loop's 15s poll
# interval, so one slow Jira call doesn't flap it red.
# BUTCHR_POLL_STALE_MS=60000

# jira_create_issue staffing (REQUIRED as of the 0.10.0 release): Atlassian
# accountIds `jira_create_issue` assigns to by issuetype, regardless of
# `parent`. Set BOTH before deploying this release — a daemon with either
# unset REFUSES to create a Story/Task of that type (an explicit `assignee`
# argument on the call still overrides). Epics are unaffected; they stay the
# human's, assigned or not.
BUTCHR_ASSIGNEE_STORY=712020:e160cf60-6480-44de-8554-af5b81c584e2
BUTCHR_ASSIGNEE_TASK=712020:619ec5ec-2e92-492f-8979-91ccda318230

# new_worker/adopt_worker staffing for a PROJECT caller's Epic (BUTCHR-71).
# Unset REFUSES the call, per-verb, naming this variable — never falls back
# to BUTCHR_ASSIGNEE_STORY/TASK. MUST NOT be the same account as this
# daemon's own project-lead identity: a project approving an epic
# (finish_worker/tell_worker) is the cross-account review hop the whole
# project-tier identity design exists for, and GitHub refuses a PR approval
# from the PR's own author. BUTCHR-62's doc records the epic-tier account
# measured on 2026-09-01 as 712020:619ec5ec-2e92-492f-8979-91ccda318230
# ("Wroos Bit") — the SAME account already used above for
# BUTCHR_ASSIGNEE_TASK, since that is the daemon that already runs the epic
# tier. Re-verify before trusting this value; it is cited, not measured, by
# whoever last wrote this file.
# BUTCHR_ASSIGNEE_EPIC=712020:619ec5ec-2e92-492f-8979-91ccda318230

# Directory the session-limit watcher's evidence captures (raw pane text) land
# in. May contain command output or secrets, so where this points matters.
# Defaults to a `.captures` directory under the workspace root.
# BUTCHR_CAPTURE_DIR=/path/to/captures
