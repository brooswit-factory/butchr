# Butchr daemon config. Copy to .env and fill in. The token is a classic
# Atlassian API token (id.atlassian.com) used as Basic auth with the email.
ATLASSIAN_SITE=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
# Prefer a file so the token never sits in the environment / shell history:
ATLASSIAN_TOKEN_FILE=/path/to/atlassian-token
# ...or inline (less safe):
# ATLASSIAN_TOKEN=your-token
BUTCHR_PORT=7717
# HERDR_SOCKET=/home/you/.config/herdr/herdr.sock   # defaults to herdr's own
