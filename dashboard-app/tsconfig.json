{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  // FACTORY-614: `src/hooks/use-dashboard.ts` and
  // `src/view-model/*-availability.ts` type-only-import the real response
  // shapes from `../src/agents/dashboard.ts` / `../src/agents/
  // query-agent-inventory.ts` (no new server API — see those modules'
  // own headers) rather than hand-duplicating them, so this program must
  // also resolve (and therefore typecheck) everything those two files
  // import. `../src/md.d.ts` is the one ambient declaration that closure
  // reaches (`workspace.ts` imports `*.md` briefs) and would otherwise
  // 404 as a module with no declaration — `bun-types` above covers every
  // `Bun.*` global the rest of that closure uses. `bun run typecheck`
  // (the root `tsconfig.json`, which already includes all of `src`) is
  // the authority on whether the backend itself type-checks; this
  // program re-checks the same files under DOM+vite's additional globals,
  // which is additive, not a second, divergent ruleset.
  "include": [
    "src",
    "vite-env.d.ts",
    "../src/agents/dashboard.ts",
    "../src/agents/query-agent-inventory.ts",
    "../src/md.d.ts",
    // FACTORY-615: the real dashboard view-model (`src/view-model/dashboard-view.ts`)
    // additionally reads the cross-link helpers, the per-daemon currency
    // shape, and `/health`'s own response shape — same "type-only-import
    // the real shape, never hand-duplicate it" discipline as the two
    // `dashboard.ts`/`query-agent-inventory.ts` entries above, so this
    // program must resolve (and typecheck) their closure too.
    "../src/agents/config-inventory-links.ts",
    "../src/daemon/currency.ts",
    "../src/daemon/health.ts",
    // FACTORY-614: the DOM-rendering component tests — see
    // `../tsconfig.json`'s own comment for why these five live here
    // instead of the root program.
    "../test/unit/dashboard-app-use-polling.test.tsx",
    "../test/unit/dashboard-app-use-dashboard.test.tsx",
    "../test/unit/dashboard-app-use-config-inventory.test.tsx",
    "../test/unit/dashboard-app-poll-status-view.test.tsx",
    "../test/unit/dashboard-app-app.test.tsx",
    "../test/unit/dashboard-app-routes.test.tsx",
    // FACTORY-615: task 3's own component tests (DOM-rendering, same reason
    // as the block above). The plain-TS view-model tests
    // (`dashboard-app-dashboard-view.test.ts`) stay in the root program,
    // same as every other `test/unit/*.test.ts`.
    "../test/unit/dashboard-app-use-health.test.tsx",
    "../test/unit/dashboard-app-status-pill.test.tsx",
    "../test/unit/dashboard-app-agent-row-card.test.tsx",
    "../test/unit/dashboard-app-withheld-row-card.test.tsx",
    "../test/unit/dashboard-app-dashboard-route.test.tsx"
  ]
}
